<?xml version="1.0"?>
<object name="portal_controlpanel">

  <!--
    Registers this add-on's settings under Site Setup -> Add-on
    Configuration (the "Products" category), reusing the same
    edit-or-add redirect view that already lives at ${portal_url}/edit.
    No new browser view needed.
  -->
  <configlet
      title="All in One Accessibility"
      action_id="all_in_one_accessibility"
      appId="plone.all_in_one_accessibility"
      category="Products"
      condition_expr=""
      icon_expr=""
      url_expr="string:${portal_url}/edit"
      visible="True">
    <permission>Manage portal</permission>
  </configlet>

</object>
